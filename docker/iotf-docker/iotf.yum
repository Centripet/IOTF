version: '3.8'

services:
  mysqldb:
    image: mysql:8.0
    container_name: ms8nacos
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: W2316195243
      MYSQL_DATABASE: nacos_iotf
      TZ: Asia/Shanghai
      LANG: C.UTF-8
    ports:
      - "43305:3306"                    # 宿主机:容器内部
    volumes:
      - mysqldb_data:/var/lib/mysql
      - ./mysql-schema.sql:/docker-entrypoint-initdb.d/mysql-schema.sql  # 自动初始化
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uroot", "-pW2316195243"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - iotf-network

  nacos:
    image: nacos/nacos-server:v3.2.0
    container_name: nacos
    restart: unless-stopped
    depends_on:
      mysqldb:
        condition: service_healthy
    ports:
      - "8080:8080"
      - "8848:8848"
      - "9848:9848"
      - "9849:9849"
      # 映射规则
    environment:
      MODE: standalone
      SPRING_DATASOURCE_PLATFORM: mysql
      MYSQL_SERVICE_HOST: mysqldb       # 容器名称（服务发现）
      MYSQL_SERVICE_PORT: 3306          # 容器内部端口，不是 43305
      MYSQL_SERVICE_DB_NAME: nacos_iotf
      MYSQL_SERVICE_USER: root
      MYSQL_SERVICE_PASSWORD: W2316195243
      MYSQL_SERVICE_DB_PARAM: 'useUnicode=true&characterEncoding=utf8&connectTimeout=1000&socketTimeout=3000&autoReconnect=true&useSSL=false&allowPublicKeyRetrieval=true'
      JVM_XMS: 512m
      JVM_XMX: 512m
      JVM_XMN: 256m
      #NACOS_AUTH_ENABLE: "false"        # 开发环境建议关闭认证
      #如果一定要开启认证，需要完整的三个配置
      NACOS_AUTH_TOKEN: "RmFrZSBUb2tlbiBmb3IgRGV2ZWxvcG1lbnQgUHVycG9zZXM="
      NACOS_AUTH_IDENTITY_KEY: "nacos"
      NACOS_AUTH_IDENTITY_VALUE: "nacos"
    volumes:
      - ./logs:/home/nacos/logs
    networks:
      - iotf-network

  postgres:
    image: postgres:16
    container_name: pgiotf
    restart: unless-stopped
    environment:
      POSTGRES_USER: root          # 数据库用户名
      POSTGRES_PASSWORD: W2316195243   # 数据库密码
      POSTGRES_DB: iotf             # 初始化数据库名
      TZ: Asia/Shanghai             # 设置时区
    ports:
      - "45434:5432"                 # 宿主机:容器端口映射
    volumes:
      - postgres-data:/var/lib/postgresql/data  # 数据持久化目录
#      - ./init:/docker-entrypoint-initdb.d  # 初始化脚本（可选）

  redis:
    image: redis:7.2-alpine
    container_name: rdsiotf
    ports:
      - "46375:6379"
    volumes:
      - redis-data:/data
    command: ["redis-server", "--appendonly", "yes"]
    restart: unless-stopped

  influxdb:
    image: influxdb:2.8.0
    container_name: fluxiotf
    restart: unless-stopped
    ports:
      - "48086:8086"
    environment:
      - DOCKER_INFLUXDB_INIT_MODE=setup
      - DOCKER_INFLUXDB_INIT_USERNAME=admin
      - DOCKER_INFLUXDB_INIT_PASSWORD=admin123456
      - DOCKER_INFLUXDB_INIT_ORG=iotf
      - DOCKER_INFLUXDB_INIT_BUCKET=energy
      - DOCKER_INFLUXDB_INIT_RETENTION=30d
    volumes:
      - influxdb_data:/var/lib/influxdb2
      - ./influxdb-config:/etc/influxdb2
    networks:
      - iotf-network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8086/health"]
      interval: 10s
      timeout: 5s
      retries: 5

  emqx:
    image: emqx/emqx:6.2.0
    container_name: emqxiotf
    restart: unless-stopped
    ports:
      - "41883:1883"       # MQTT 主要服务端口
      - "48083:8083"       # WebSocket 端口（Web端调试）
      - "18083:18083"      # Dashboard 管理界面
    environment:
      - EMQX_NAME=emqx-iotf
      - EMQX_HOST=localhost
      - EMQX_DASHBOARD__DEFAULT_USERNAME=admin
      - EMQX_DASHBOARD__DEFAULT_PASSWORD=admin123456
    volumes:
      - emqx_data:/opt/emqx/data
      - emqx_log:/opt/emqx/log
    networks:
      - iotf-network


networks:
  iotf-network:
    driver: bridge

volumes:
  mysqldb_data:
  postgres-data:
  redis-data:
  influxdb_data:
  emqx_data:
  emqx_log:

